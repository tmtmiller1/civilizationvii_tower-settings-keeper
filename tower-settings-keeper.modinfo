<?xml version="1.0" encoding="utf-8"?>
<!--
  Tower Settings Keeper, a Civilization VII mod.
  Makes mod settings survive a restart. The game's localStorage returns the first stored row for every key it is
  asked for, so settings panels lose what they saved. This mod keeps every key inside the one row the game can read
  and answers every localStorage call from it, in the main menu and in the game. No data of its own, no UI.
  LoadOrder 1 asks to run first; the loader does not promise it, and the keeper works whichever order it gets.
-->
<Mod id="tower-settings-keeper" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_SETTINGS_KEEPER_MOD_NAME</Name>
        <Description>LOC_SETTINGS_KEEPER_MOD_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <Package>TowerSettingsKeeper</Package>
        <PackageSortIndex>1</PackageSortIndex>
        <Version>1.1.1</Version>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="settings-keeper-shell" scope="shell" criteria="always">
            <Properties><LoadOrder>1</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/TowerSettingsKeeperText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/sk-options.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <ActionGroup id="settings-keeper-game" scope="game" criteria="always">
            <Properties><LoadOrder>1</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/TowerSettingsKeeperText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/sk-options.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>
