<?xml version="1.0" encoding="utf-8"?>
<!--
  Tower Settings Keeper, a Civilization VII mod.
  Keeps mod settings across restarts. The game's localStorage returns the first stored row for every key, so
  settings panels lose what they saved. This mod keeps every key inside the one row the game can read and answers
  every localStorage call from it, in the main menu and in a game. No gameplay change. It also carries the
  Civilopedia History Corrections text (history-corrections/), loaded only with Civilopedia Expanded in use.
  LoadOrder 1 asks the loader to run it first. The loader does not promise that, and the mod works in any order.
-->
<Mod id="tower-settings-keeper" version="1" xmlns="ModInfo">
    <Properties>
        <Name>LOC_SETTINGS_KEEPER_MOD_NAME</Name>
        <Description>LOC_SETTINGS_KEEPER_MOD_DESCRIPTION</Description>
        <Authors>Tower</Authors>
        <Package>TowerSettingsKeeper</Package>
        <PackageSortIndex>1</PackageSortIndex>
        <Version>1.3.1</Version>
        <AffectsSavedGames>0</AffectsSavedGames>
    </Properties>
    <Dependencies>
        <Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
    </Dependencies>
    <ActionCriteria>
        <Criteria id="always"><AlwaysMet></AlwaysMet></Criteria>
        <!-- Civilopedia History Corrections: the history text on six independent-power pages from Civilopedia
             Expanded: Independents. Each group needs that mod in use, so without it the game's pages are left as
             they are. The text in history-corrections/ is a copy kept in step with the standalone mod. -->
        <Criteria id="history-corrections-antiquity">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_ANTIQUITY</AgeInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration-sengoku">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <ModInUse>sengoku</ModInUse>
        </Criteria>
        <Criteria id="history-corrections-exploration-mlcs">
            <ModInUse>maple-leaves-civilopedia-expanded</ModInUse>
            <AgeInUse>AGE_EXPLORATION</AgeInUse>
            <ModInUse>ml-city-states-expanded</ModInUse>
        </Criteria>
    </ActionCriteria>
    <ActionGroups>
        <ActionGroup id="settings-keeper-shell" scope="shell" criteria="always">
            <Properties><LoadOrder>1</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/TowerSettingsKeeperText.xml</Item>
                    <Item locale="de_DE">text/de_de/TowerSettingsKeeperText.xml</Item>
                    <Item locale="es_ES">text/es_es/TowerSettingsKeeperText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/TowerSettingsKeeperText.xml</Item>
                    <Item locale="it_IT">text/it_it/TowerSettingsKeeperText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/TowerSettingsKeeperText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/TowerSettingsKeeperText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/TowerSettingsKeeperText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/TowerSettingsKeeperText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/TowerSettingsKeeperText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/TowerSettingsKeeperText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/TowerSettingsKeeperText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/sk-options.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <ActionGroup id="settings-keeper-game" scope="game" criteria="always">
            <Properties><LoadOrder>1</LoadOrder></Properties>
            <Actions>
                <UpdateText>
                    <Item>text/en_us/TowerSettingsKeeperText.xml</Item>
                    <Item locale="de_DE">text/de_de/TowerSettingsKeeperText.xml</Item>
                    <Item locale="es_ES">text/es_es/TowerSettingsKeeperText.xml</Item>
                    <Item locale="fr_FR">text/fr_fr/TowerSettingsKeeperText.xml</Item>
                    <Item locale="it_IT">text/it_it/TowerSettingsKeeperText.xml</Item>
                    <Item locale="ja_JP">text/ja_jp/TowerSettingsKeeperText.xml</Item>
                    <Item locale="ko_KR">text/ko_kr/TowerSettingsKeeperText.xml</Item>
                    <Item locale="pl_PL">text/pl_pl/TowerSettingsKeeperText.xml</Item>
                    <Item locale="pt_BR">text/pt_br/TowerSettingsKeeperText.xml</Item>
                    <Item locale="ru_RU">text/ru_ru/TowerSettingsKeeperText.xml</Item>
                    <Item locale="zh_Hans_CN">text/zh_cn/TowerSettingsKeeperText.xml</Item>
                    <Item locale="zh_Hant_HK">text/zh_hk/TowerSettingsKeeperText.xml</Item>
                </UpdateText>
                <UIScripts>
                    <Item>ui/settings-keeper.js</Item>
                    <Item>ui/sk-options.js</Item>
                </UIScripts>
            </Actions>
        </ActionGroup>
        <!-- Civilopedia History Corrections, loaded at 1000 to come after Civilopedia Expanded's groups (10, 100
             and 210). Text only. -->
        <ActionGroup id="history-corrections-antiquity-text" scope="game" criteria="history-corrections-antiquity">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/antiquity-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-text" scope="game" criteria="history-corrections-exploration">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-sengoku-text" scope="game" criteria="history-corrections-exploration-sengoku">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-sengoku-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
        <ActionGroup id="history-corrections-exploration-mlcs-text" scope="game" criteria="history-corrections-exploration-mlcs">
            <Properties>
                <LoadOrder>1000</LoadOrder>
            </Properties>
            <Actions>
                <UpdateText>
                    <Item>history-corrections/exploration-mlcs-text.xml</Item>
                </UpdateText>
            </Actions>
        </ActionGroup>
    </ActionGroups>
</Mod>
